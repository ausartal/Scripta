  "narrative": {
    "northStar": "The Illustrated Launchpad",
    "overview": "Scripta uses original character illustration, editorial display type, and saturated regional color to make an unfinished idea feel active and possible. Calm paper sections preserve clarity between expressive moments.",
    "keyCharacteristics": ["Original character illustration as primary material", "Anton display with Inter body", "Regional purple and orange surfaces", "Asymmetric compositions with accessible controls", "Honest labels for illustrative content"],
    "rules": [
      { "name": "The Surface Rule", "body": "Purple, orange, paper, and ink own whole regions.", "section": "colors" },
      { "name": "The Contrast Rule", "body": "Use darker display orange for text on paper and action orange for surfaces.", "section": "colors" },
      { "name": "The Two-Voice Rule", "body": "Anton expresses the studio; Inter explains and operates it.", "section": "typography" }
    ],
    "dos": ["Use original Figma illustrations", "Preserve the complete color rhythm", "Label illustrative content honestly", "Keep accessible focus and touch targets"],
