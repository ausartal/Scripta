      "css": ".ds-button-outline{display:inline-flex;align-items:center;min-height:50px;padding:14px 25px;border:2px solid currentColor;border-radius:8px;color:#212529;font:700 13px Inter,sans-serif;text-decoration:none}.ds-button-outline:hover{background:rgba(33,37,41,.07)}.ds-button-outline:focus-visible{outline:3px solid #8338ec;outline-offset:5px}"
